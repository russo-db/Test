# --- Обязательные ---

# Токен бота от @BotFather
BOT_TOKEN=123456:ABCdefGhIJKlmNoPQRsTUVwxyZ

# Публичный HTTPS-адрес, где развёрнуто приложение. Со слешем на конце.
WEB_APP_URL=https://your-app.example.com/

# Имя бота без @. Можно не задавать: при запуске оно берётся у Telegram
# через getMe. Задавай, только если нужно переопределить.
# BOT_USERNAME=your_bot

# --- База ---

# Строка подключения MongoDB. Если задана — используется Mongo.
# Если не задана, приложение падает обратно на локальный SQLite.
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/?retryWrites=true&w=majority

# Имя базы внутри кластера (по умолчанию monstergram)
MONGODB_DB=monstergram

# --- Необязательные ---

# Порт. Большинство хостингов подставляют его сами — тогда не задавай.
# PORT=8000

# Путь к файлу SQLite. Нужен только если MONGODB_URI не задан
# и диск хостинга эфемерный: укажи путь на подключённом томе.
# DB_PATH=/data/monster_database.db

# --- Кошелёк TON ---

# Адрес кошелька проекта — на него игроки шлют пополнения.
# Без него разделы «Пополнить» и «Вывести» в приложении выключены.
TON_WALLET=UQ...

# Куда слать заявки на вывод (свой Telegram-id можно узнать у @userinfobot).
ADMIN_CHAT_ID=123456789

# --- Админ-панель (/admin) ---

# Пароль от админ-панели. Без него /admin недоступна.
ADMIN_PASSWORD=

# Ключ toncenter от @tonapibot. Без ключа лимит запросов ниже, но всё работает.
# TONCENTER_API_KEY=

# Адрес API и период фоновой проверки пополнений в секундах.
# TON_API_URL=https://toncenter.com/api/v3
# TON_POLL_SECONDS=30
